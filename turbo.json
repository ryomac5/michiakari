{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CONTENT_DIR",
        "JUDGE_MODE",
        "NEXT_PUBLIC_AGENT_URL",
        "ANTHROPIC_API_KEY",
        "PORT",
        "CORS_ORIGINS",
        "RATE_LIMIT_PER_MINUTE",
        "TRUST_PROXY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "lint": {},
    "data:build": {
      "cache": false
    }
  }
}
